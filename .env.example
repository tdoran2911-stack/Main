# NewsAPI.org — free dev key at https://newsapi.org/register
# Works from localhost in development (browser-side). Use a server proxy in production.
VITE_NEWS_API_KEY=your_newsapi_key_here

# GitHub Personal Access Token — increases rate limit from 60 to 5000 req/hr
# Create at https://github.com/settings/tokens (no scopes needed for public data)
VITE_GITHUB_TOKEN=your_github_token_here
