# ── News ────────────────────────────────────────────────────────────────────
# NewsAPI.org — free dev key at https://newsapi.org/register
VITE_NEWS_API_KEY=your_newsapi_key_here

# ── Candidate Search: People Data Labs ──────────────────────────────────────
# Powers the Search tab with real candidate profiles (3B+ profiles, NYC filter)
# Plans at https://www.peopledatalabs.com/pricing — starts ~$0.10/profile
VITE_PDL_API_KEY=your_pdl_api_key_here

# ── Open to Work: LinkedIn Recruiter System Connect ──────────────────────────
# Requires enterprise LinkedIn Recruiter + RSC partnership approval
# Setup: LinkedIn Recruiter → Admin → Recruiter System Connect
# Docs: https://learn.microsoft.com/en-us/linkedin/talent/recruiter-system-connect
VITE_LINKEDIN_RSC_TOKEN=your_linkedin_rsc_token_here

# ── Pipeline: Ashby ATS ──────────────────────────────────────────────────────
# Pulls real applicants from your Ashby ATS into the Pipeline tab
# Get API key: Ashby → Settings → Integrations → API Keys
# Docs: https://developers.ashbyhq.com/reference/introduction
VITE_ASHBY_API_KEY=your_ashby_api_key_here
